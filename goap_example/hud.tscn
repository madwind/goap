[gd_scene format=3]

[ext_resource type="PackedScene" path="res://addons/goap/runtime/goap_runtime_monitor.tscn" id="4_monitor"]

[ext_resource type="Script" path="res://goap_example/performance.gd" id="1_performance"]

[ext_resource type="Script" path="res://goap_example/hud.gd" id="2_hud"]

[ext_resource type="Script" path="res://goap_example/map_overlay.gd" id="3_overlay"]

[ext_resource type="Script" path="res://goap_example/overhead_vitals.gd" id="4_overhead"]
[ext_resource type="Script" path="res://goap_example/world_health_bars.gd" id="5_world_bars"]

[sub_resource type="StyleBoxFlat" id="Page"]
content_margin_left = 22.0
content_margin_top = 22.0
content_margin_right = 22.0
content_margin_bottom = 22.0
bg_color = Color(0.09, 0.12, 0.16, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_left = 8
corner_radius_bottom_right = 8

[sub_resource type="StyleBoxFlat" id="VitalsPanel"]
content_margin_left = 7.0
content_margin_top = 4.0
content_margin_right = 7.0
content_margin_bottom = 4.0
bg_color = Color(0.07, 0.11, 0.14, 0.88)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_left = 8
corner_radius_bottom_right = 8

[node name="HUD" instance=ExtResource("4_monitor")]
script = ExtResource("2_hud")
performance_page_path = NodePath("RuntimeWindow/RuntimePanel/Column/Tabs/Performance/Performance/Column")
show_on_ready = false
include_inspector_page = false

[node name="Root" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Overlay" type="Control" parent="Root"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("3_overlay")

[node name="WorldHealthBars" type="Control" parent="Root"]
